	(text "C2: output AC coupling (bias removal)\nHigh-pass filter with SGTL5000 input impedance\nfc = 1/(2*pi*R*C), R=10k (SGTL5000 LINEIN), C=10uF\nfc ~ 1.6 Hz"
		(exclude_from_sim no)
		(at 144.78 92.202 0)
